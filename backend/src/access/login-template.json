"<!doctype html><html lang=\"ko\" class=\"ws-app ws-project-gimpo\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>백업·복구 · 로그인</title><link rel=\"stylesheet\" href=\"__PREFIX__/ws-login.css\"><script src=\"__PREFIX__/ws-theme.js\"></script></head><body><main class=\"ws-auth-screen\"><section class=\"ws-auth-card\"><div class=\"ws-auth-heading\"><span class=\"ws-auth-mark\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><rect x=\"3\" y=\"3\" width=\"7\" height=\"7\" rx=\"2\"/><rect x=\"14\" y=\"3\" width=\"7\" height=\"7\" rx=\"2\"/><rect x=\"3\" y=\"14\" width=\"7\" height=\"7\" rx=\"2\"/><rect x=\"14\" y=\"14\" width=\"7\" height=\"7\" rx=\"2\" opacity=\".55\"/></svg></span><h2 id=\"access-title\">로그인</h2><p id=\"intro\">계정 정보를 확인하고 있습니다.</p></div><label style=\"display:block;margin-bottom:20px\">테마<select data-ws-theme-select aria-label=\"테마\"><option value=\"system\">시스템</option><option value=\"light\">Light</option><option value=\"dark\">Dark</option></select></label><form id=\"access-form\"><fieldset id=\"proof\" hidden style=\"border:0;padding:0;margin:0\"><legend>canggu 관리자 확인</legend><div class=\"ws-auth-field\"><label for=\"canggu-user\">canggu 관리자 아이디</label><input id=\"canggu-user\" autocomplete=\"off\" maxlength=\"128\"></div><div class=\"ws-auth-field\"><label for=\"canggu-password\">canggu 관리자 비밀번호</label><input id=\"canggu-password\" type=\"password\" autocomplete=\"off\" maxlength=\"4096\"></div></fieldset><div class=\"ws-auth-field\"><label for=\"username\">아이디</label><input id=\"username\" name=\"username\" autocomplete=\"username\" required maxlength=\"128\"></div><div class=\"ws-auth-field\"><label for=\"password\">비밀번호</label><input id=\"password\" name=\"password\" type=\"password\" autocomplete=\"current-password\" required maxlength=\"1024\"></div><div class=\"ws-auth-field\" id=\"confirmation\" hidden><label for=\"confirm-password\">새 비밀번호 확인</label><input id=\"confirm-password\" type=\"password\" autocomplete=\"new-password\" maxlength=\"1024\"></div><p id=\"feedback\" class=\"ws-auth-feedback\" role=\"status\"></p><button type=\"submit\" id=\"submit\" disabled>로그인</button></form></section></main><script>\n(function(){'use strict';var form=document.getElementById('access-form'),button=document.getElementById('submit'),feedback=document.getElementById('feedback'),setup=false;function input(id){return document.getElementById(id);}async function call(path,body){var response=await fetch('__PREFIX__/api/auth/'+path,{method:body?'POST':'GET',credentials:'same-origin',cache:'no-store',headers:{'Content-Type':'application/json'},body:body?JSON.stringify(body):undefined});var result=await response.json();if(!response.ok)throw new Error(typeof result.detail==='string'?result.detail:'요청을 처리하지 못했습니다.');return result;}async function state(){try{var status=await call('status');setup=!!status.bootstrapRequired;input('proof').hidden=!setup;input('confirmation').hidden=!setup;['canggu-user','canggu-password','confirm-password'].forEach(function(id){input(id).required=setup;});input('password').minLength=setup?8:1;input('password').autocomplete=setup?'new-password':'current-password';input('access-title').textContent=setup?'최초 관리자 등록':'로그인';input('intro').textContent=setup?'canggu 관리자 확인 후 이 서비스의 독립 관리자 계정을 만드세요.':'백업·복구 계정으로 로그인해 주세요.';button.textContent=setup?'관리자 계정 만들기':'로그인';button.disabled=false;}catch(error){feedback.textContent=error.message;}}form.addEventListener('submit',async function(event){event.preventDefault();feedback.textContent='';if(setup&&input('password').value!==input('confirm-password').value){feedback.textContent='새 비밀번호가 일치하지 않습니다.';input('confirm-password').focus();return;}button.disabled=true;var body={username:input('username').value.trim(),password:input('password').value};if(setup){body.confirm_password=input('confirm-password').value;body.canggu_username=input('canggu-user').value;body.canggu_password=input('canggu-password').value;}try{var result=await call(setup?'bootstrap':'login',body);if(setup){form.reset();await state();feedback.textContent='관리자 계정이 생성되었습니다. 새 계정으로 로그인해 주세요.';}else location.replace(result.next||'__PREFIX__/');}catch(error){feedback.textContent=error.message;button.disabled=false;input('canggu-password').value='';}});state();}());\n</script></body></html>\n"
